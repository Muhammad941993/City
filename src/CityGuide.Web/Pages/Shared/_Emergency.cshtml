@model IReadOnlyList<Place>
@if (Model.Count > 0)
{
    <section class="card pad stack" aria-labelledby="emergency-title">
        <h2 id="emergency-title" style="color:#A52D2D">أرقام الطوارئ</h2>
        <div class="emergency">
            @foreach (var p in Model)
            {
                <a href="@Phone.TelLink(p.Phone)"><span>@p.Name</span><span class="num">@p.Phone</span></a>
            }
        </div>
    </section>
}
