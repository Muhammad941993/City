@page
@model ErrorModel
@{
    ViewData["Title"] = "حصلت مشكلة";
    ViewData["NoIndex"] = true;
}
<div class="page narrow" style="margin:0 auto">
    <section class="card pad stack" style="text-align:center; padding:32px 16px">
        <h1>حصلت مشكلة</h1>
        <p class="muted">جرب تاني بعد شوية.</p>
        @if (Model.ShowRequestId) { <p class="muted small ltr">@Model.RequestId</p> }
        <a class="btn btn-primary" href="/">الرئيسية</a>
    </section>
</div>
